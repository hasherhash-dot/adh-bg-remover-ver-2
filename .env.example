# ---------------------------------------------------------------------------
# ADH Background Remover — environment configuration
#
# Copy to `.env.local` for local development:   cp .env.example .env.local
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and must never be imported into a client
# component. `src/lib/config/env.ts` enforces this at runtime.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public base URL of the web app. Used for canonical URLs, OG tags, sitemap
# and as the default API origin for the browser extension.
NEXT_PUBLIC_APP_URL=http://localhost:3000
/background-remover
# Leave empty to serve from the root, which is what local development does.

# --- Background removal engine ----------------------------------------------
# Which provider the BackgroundRemovalService resolves at runtime.
#   local     - On-device ONNX inference via @imgly/background-removal-node.
#               No API key, no network calls, no per-image cost. (default)
#   http      - Any HTTP service that accepts an image and returns a PNG.
#               Configure with BACKGROUND_REMOVAL_API_URL below.
#   replicate - Replicate-hosted segmentation model.
#   mock      - Deterministic no-AI provider used by the test suite.
BACKGROUND_REMOVAL_PROVIDER=local

# Model size for the `local` provider: small | medium | large.
# `medium` is the quality/latency sweet spot and is the default.
BACKGROUND_REMOVAL_MODEL=medium

# Longest edge (px) the image is downscaled to before inference. The alpha mask
# is upscaled and composited back onto the ORIGINAL image, so output resolution
# is never reduced by this setting — it only bounds inference memory and time.
# Raise for finer edge detail, lower for speed. 1024 matches the model's
# native input resolution.
BACKGROUND_REMOVAL_INFERENCE_SIZE=1024

# --- Remote provider credentials (server-only, never sent to the browser) ----
# Required when BACKGROUND_REMOVAL_PROVIDER=http
BACKGROUND_REMOVAL_API_URL=
BACKGROUND_REMOVAL_API_KEY=

# Required when BACKGROUND_REMOVAL_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

# --- Upload limits ----------------------------------------------------------
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=25
# Maximum number of images accepted by the batch endpoint in one request.
MAX_BATCH_SIZE=20
# Hard cap on source image megapixels. Protects against decompression bombs.
MAX_IMAGE_MEGAPIXELS=50

# --- Rate limiting ----------------------------------------------------------
# Sliding-window limiter. `memory` is per-process and suitable for a single
# instance; swap to a Redis driver in production (see src/lib/api/rate-limit).
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_BATCH_PER_HOUR=10
# REDIS_URL=

# --- Storage ----------------------------------------------------------------
# Where processed images live. Uploads are ephemeral by default: nothing is
# written to disk unless a durable driver is configured.
#   ephemeral - buffers only, never persisted (default, most private)
#   local     - temp directory on the server, swept by a TTL
#   s3 | r2 | supabase - not implemented; see docs/ARCHITECTURE.md
STORAGE_DRIVER=ephemeral
STORAGE_TEMP_DIR=.data/tmp
# Seconds before a temporary file is eligible for deletion.
STORAGE_TTL_SECONDS=900
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=

# --- Persistence ------------------------------------------------------------
# API keys and usage counters. `file` writes JSON under .data/ and is intended
# for local development only. Point DATABASE_URL at Postgres in production.
PERSISTENCE_DRIVER=file
DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# `anonymous` issues a signed cookie so usage can be tracked without accounts.
# Swap for a real provider (NextAuth, Clerk, Supabase) behind src/lib/auth.
AUTH_DRIVER=anonymous
# Secret used to sign the anonymous session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Billing ----------------------------------------------------------------
# Payments are NOT implemented. The plan catalogue and entitlement checks are
# real; the checkout call is isolated in src/lib/billing/stripe.ts and throws
# until these are configured.
BILLING_DRIVER=disabled
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Analytics --------------------------------------------------------------
# console | none | http. Events are defined in src/lib/analytics/events.ts.
NEXT_PUBLIC_ANALYTICS_DRIVER=none
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Background-removal engine.
#   adh-onnx  The ADH engine: BiRefNet-lite 640 through ONNX Runtime.
#             THE DEFAULT. Needs models/birefnet-lite-640.onnx and its
#             .onnx.data — see models/README.md.
#   local     IMG.LY / ISNet. Still available, still tested, still the
#             engine in the frozen Version A backup. One variable away.
BACKGROUND_REMOVAL_PROVIDER=adh-onnx

# Standby engine. Unset by default.
#
# Only engages when the primary cannot START — missing model, session will
# not open. Never on a per-image processing failure, which must surface.
# Results are always attributed to the engine that actually ran, and the
# switch is logged loudly.
#
# Leave this unset while comparing engines: an automatic switch would
# attribute one engine's work to the other on exactly the images where they
# differ most.
# BACKGROUND_REMOVAL_FALLBACK=local

# ADH engine only. Path defaults to models/birefnet-lite-640.onnx.
# ADH_MODEL_PATH=models/birefnet-lite-640.onnx
# 8 threads measured fastest on a 12-core CPU; the curve is flat past that
# because the model is memory-bandwidth bound.
# ADH_THREADS=8
